# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Max upload size shown/enforced client-side, in MB. Keep in sync with the
# backend's MAX_UPLOAD_MB (default 250).
NEXT_PUBLIC_MAX_UPLOAD_MB=250

# Public site identity (baked in at build time). Defaults shown.
# Must include the scheme, e.g. https://
NEXT_PUBLIC_SITE_URL=https://omnilisten.esap.ai
# Commercial Registration number shown in legal documents. Leave empty until available.
NEXT_PUBLIC_COMPANY_CR=
